'use client';

import React, { useState } from 'react';
import jsPDF from 'jspdf';
import autoTable from 'jspdf-autotable';

interface UserSession {
  id: string;
  name: string;
  email: string;
  role: 'ADMIN' | 'TREASURER' | 'KORLAS' | 'STUDENT' | 'PARENT';
  nis?: string;
  nisn?: string;
  className?: string;
  managedClass?: string; // Multi-tenancy class scope for Korlas
  studentId?: string;
  token: string;
}

interface UserAccount {
  id: string;
  name: string;
  email: string;
  role: 'ADMIN' | 'TREASURER' | 'KORLAS' | 'STUDENT' | 'PARENT';
  nis?: string;
  nisn?: string;
  className?: string;
  managedClass?: string;
  studentId?: string;
  studentName?: string;
  gender?: 'MALE' | 'FEMALE';
  religion?: string;
  status: 'ACTIVE' | 'INACTIVE';
}

interface Transaction {
  id: string;
  type: 'INCOME' | 'EXPENSE';
  category: string;
  incomeSource?: string;
  description: string;
  className?: string; // Class attribution for multi-tenancy
  amount: number;
  recordedBy: string;
  paymentMethod: string;
  date: string;
}

interface StudentBilling {
  id: string;
  studentId: string;
  nis: string;
  nisn: string;
  studentName: string;
  className?: string; // Class attribution for multi-tenancy
  schemeTitle: string;
  period: string; // e.g. "Agustus 2026"
  amountDue: number;
  amountPaid: number;
  status: 'PAID' | 'PARTIAL' | 'PENDING';
  paidAt?: string;
  paymentMethod?: string;
}

export default function DashboardPage() {
  // Authentication State
  const [currentUser, setCurrentUser] = useState<UserSession | null>(null);
  const [loginEmail, setLoginEmail] = useState<string>('bendahara@sdn08pagi.sch.id');
  const [loginPassword, setLoginPassword] = useState<string>('Password123!');
  const [loginError, setLoginError] = useState<string>('');
  const [isLoggingIn, setIsLoggingIn] = useState<boolean>(false);

  // Active Tab Views
  const [activeTab, setActiveTab] = useState<'OVERVIEW' | 'LEDGER' | 'STUDENTS' | 'REPORTS' | 'USERS'>('OVERVIEW');
  const [portalTab, setPortalTab] = useState<'CURRENT' | 'HISTORY'>('CURRENT');
  const [reportPeriodFilter, setReportPeriodFilter] = useState<string>('Agustus 2026');
  const [reportStatusFilter, setReportStatusFilter] = useState<'ALL' | 'PAID' | 'PENDING'>('ALL');

  // Modals
  const [showTransactionModal, setShowTransactionModal] = useState<boolean>(false);
  const [showStudentModal, setShowStudentModal] = useState<boolean>(false);
  const [showUserModal, setShowUserModal] = useState<boolean>(false);
  const [showScheduleModal, setShowScheduleModal] = useState<boolean>(false);
  const [showPayModal, setShowPayModal] = useState<boolean>(false);
  const [showProfileModal, setShowProfileModal] = useState<boolean>(false);
  const [showPdfEmailModal, setShowPdfEmailModal] = useState<boolean>(false);
  const [showStudentDetailModal, setShowStudentDetailModal] = useState<boolean>(false);
  
  // Selected Objects
  const [selectedBilling, setSelectedBilling] = useState<StudentBilling | null>(null);
  const [selectedStudentDetail, setSelectedStudentDetail] = useState<UserAccount | null>(null);
  const [pdfReportType, setPdfReportType] = useState<'LEDGER' | 'REPORTS'>('LEDGER');
  const [targetEmail, setTargetEmail] = useState<string>('');
  const [payMethod, setPayMethod] = useState<string>('Tunai / Cash');

  // Profile Change Password Form State
  const [profileName, setProfileName] = useState<string>('');
  const [oldPassword, setOldPassword] = useState<string>('');
  const [newPassword, setNewPassword] = useState<string>('');

  // Notification Toast
  const [toastMessage, setToastMessage] = useState<string>('');
  const [studentValidationError, setStudentValidationError] = useState<string>('');

  // Student Direct Add Form State
  const [studentNis, setStudentNis] = useState<string>('');
  const [studentNisn, setStudentNisn] = useState<string>('');
  const [studentName, setStudentName] = useState<string>('');
  const [studentClass, setStudentClass] = useState<string>('Kelas 5-A');
  const [studentEmail, setStudentEmail] = useState<string>('');
  const [studentPassword, setStudentPassword] = useState<string>('Password123!');
  const [studentGender, setStudentGender] = useState<'MALE' | 'FEMALE'>('MALE');
  const [studentReligion, setStudentReligion] = useState<string>('ISLAM');

  // User Creation Form State (Admin)
  const [newUserName, setNewUserName] = useState<string>('');
  const [newUserEmail, setNewUserEmail] = useState<string>('');
  const [newUserPassword, setNewUserPassword] = useState<string>('Password123!');
  const [newUserRole, setNewUserRole] = useState<'ADMIN' | 'TREASURER' | 'KORLAS' | 'PARENT'>('KORLAS');
  const [selectedChildStudentId, setSelectedChildStudentId] = useState<string>('');
  const [selectedKorlasClass, setSelectedKorlasClass] = useState<string>('Kelas 5-A');

  // Cron Schedule Form State
  const [cronDay, setCronDay] = useState<number>(1);
  const [cronAmount, setCronAmount] = useState<number>(25000);
  const [cronTitle, setCronTitle] = useState<string>('Iuran Kas Wajib Bulanan');

  // Registered User Accounts List
  const [userAccounts, setUserAccounts] = useState<UserAccount[]>([
    { id: 'u-1', name: 'Budi Santoso', email: 'admin@sdn08pagi.sch.id', role: 'ADMIN', status: 'ACTIVE' },
    { id: 'u-2', name: 'Siti Rahma', email: 'bendahara@sdn08pagi.sch.id', role: 'TREASURER', status: 'ACTIVE' },
    { id: 'u-3', name: 'Andi Wijaya', email: 'andi@sdn08pagi.sch.id', role: 'STUDENT', nis: '20260501', nisn: '0051234567', className: 'Kelas 5-A', gender: 'MALE', religion: 'ISLAM', status: 'ACTIVE' },
    { id: 'u-4', name: 'Dewi Lestari', email: 'dewi@sdn08pagi.sch.id', role: 'STUDENT', nis: '20260502', nisn: '0051234568', className: 'Kelas 5-A', gender: 'FEMALE', religion: 'CHRISTIAN', status: 'ACTIVE' },
    { id: 'u-5', name: 'Rian Pratama', email: 'rian@sdn08pagi.sch.id', role: 'STUDENT', nis: '20260503', nisn: '0051234569', className: 'Kelas 5-A', gender: 'MALE', religion: 'HINDU', status: 'ACTIVE' },
    { id: 'u-6', name: 'Wali Murid Andi', email: 'orangtua.andi@sdn08pagi.sch.id', role: 'PARENT', studentId: 'u-3', studentName: 'Andi Wijaya', status: 'ACTIVE' },
    { id: 'u-7', name: 'Korlas 5-A (Ibu Ratna)', email: 'korlas.5a@sdn08pagi.sch.id', role: 'KORLAS', managedClass: 'Kelas 5-A', status: 'ACTIVE' },
  ]);

  // Transaction Ledger State
  const [transactions, setTransactions] = useState<Transaction[]>([
    {
      id: 'tx-1',
      type: 'INCOME',
      category: 'Pemasukan Kas',
      incomeSource: 'Iuran Kas Siswa',
      description: 'Pembayaran Iuran Kas Agustus oleh Andi Wijaya (NIS: 20260501)',
      className: 'Kelas 5-A',
      amount: 25000,
      recordedBy: 'Siti Rahma (Bendahara)',
      paymentMethod: 'Tunai / Cash',
      date: '2026-07-29 09:30',
    },
    {
      id: 'tx-2',
      type: 'INCOME',
      category: 'Pemasukan Kas',
      incomeSource: 'Sumbangan / Donasi Orang Tua',
      description: 'Donasi Bantuan Pembelian Kipas Angin Kelas oleh Wali Murid',
      className: 'Kelas 5-A',
      amount: 150000,
      recordedBy: 'Siti Rahma (Bendahara)',
      paymentMethod: 'Transfer Bank (BCA)',
      date: '2026-07-29 10:15',
    },
    {
      id: 'tx-3',
      type: 'EXPENSE',
      category: 'Pengeluaran Kas',
      description: 'Pembelian Spidol Whiteboard & Penghapus Kelas 5-A',
      className: 'Kelas 5-A',
      amount: 45000,
      recordedBy: 'Siti Rahma (Bendahara)',
      paymentMethod: 'Tunai / Cash',
      date: '2026-07-30 14:00',
    },
  ]);

  // Student Billing Dues State
  const [billings, setBillings] = useState<StudentBilling[]>([
    { id: 'b-1', studentId: 'u-3', nis: '20260501', nisn: '0051234567', studentName: 'Andi Wijaya', className: 'Kelas 5-A', schemeTitle: 'Iuran Kas Agustus 2026', period: 'Agustus 2026', amountDue: 25000, amountPaid: 25000, status: 'PAID', paidAt: '2026-07-29 09:30', paymentMethod: 'Tunai / Cash' },
    { id: 'b-2', studentId: 'u-4', nis: '20260502', nisn: '0051234568', studentName: 'Dewi Lestari', className: 'Kelas 5-A', schemeTitle: 'Iuran Kas Agustus 2026', period: 'Agustus 2026', amountDue: 25000, amountPaid: 25000, status: 'PAID', paidAt: '2026-07-29 10:15', paymentMethod: 'Transfer Bank (BCA)' },
    { id: 'b-3', studentId: 'u-5', nis: '20260503', nisn: '0051234569', studentName: 'Rian Pratama', className: 'Kelas 5-A', schemeTitle: 'Iuran Kas Agustus 2026', period: 'Agustus 2026', amountDue: 25000, amountPaid: 0, status: 'PENDING' },
    { id: 'b-4', studentId: 'u-3', nis: '20260501', nisn: '0051234567', studentName: 'Andi Wijaya', className: 'Kelas 5-A', schemeTitle: 'Iuran Pentas Seni 2026', period: 'September 2026', amountDue: 50000, amountPaid: 0, status: 'PENDING' },
  ]);

  // Transaction & Mutasi Form State
  const [txnType, setTxnType] = useState<'INCOME' | 'EXPENSE'>('INCOME');
  const [txnAmount, setTxnAmount] = useState<string>('');
  const [incomeSource, setIncomeSource] = useState<string>('Iuran Kas Siswa');
  const [txnDescription, setTxnDescription] = useState<string>('');

  // ----------------------------------------------------
  // STRICT MULTI-TENANCY DATA FILTERING FOR KORLAS
  // ----------------------------------------------------
  const scopedTransactions = transactions.filter((t) => {
    if (currentUser?.role === 'KORLAS' && currentUser.managedClass) {
      return t.className === currentUser.managedClass;
    }
    return true;
  });

  const scopedBillings = billings.filter((b) => {
    if (currentUser?.role === 'KORLAS' && currentUser.managedClass) {
      return b.className === currentUser.managedClass;
    }
    return true;
  });

  const scopedStudents = userAccounts.filter((u) => {
    if (u.role !== 'STUDENT') return false;
    if (currentUser?.role === 'KORLAS' && currentUser.managedClass) {
      return u.className === currentUser.managedClass;
    }
    return true;
  });

  // Dynamic Live Database Calculations for Scoped View
  const totalIncome = scopedTransactions.filter((t) => t.type === 'INCOME').reduce((sum, t) => sum + t.amount, 0);
  const totalExpense = scopedTransactions.filter((t) => t.type === 'EXPENSE').reduce((sum, t) => sum + t.amount, 0);
  const computedBalance = totalIncome - totalExpense;

  const totalDuesExpected = scopedBillings.reduce((sum, b) => sum + b.amountDue, 0);
  const totalDuesCollected = scopedBillings.reduce((sum, b) => sum + b.amountPaid, 0);
  const totalPendingDues = totalDuesExpected - totalDuesCollected;
  const computedCollectionRate = totalDuesExpected > 0 ? ((totalDuesCollected / totalDuesExpected) * 100).toFixed(1) : '0';

  const formatIDR = (val: number) => {
    return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(val);
  };

  const showToast = (msg: string) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(''), 4000);
  };

  // Live REST API Login
  const handleLogin = async (e: React.FormEvent) => {
    e.preventDefault();
    setLoginError('');
    setIsLoggingIn(true);

    try {
      const res = await fetch('http://localhost:3001/api/v1/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: loginEmail, password: loginPassword }),
      });

      if (res.ok) {
        const data = await res.json();
        setCurrentUser({
          id: data.user.id,
          name: data.user.name,
          email: data.user.email,
          role: data.user.role,
          nis: data.user.nis,
          nisn: data.user.nisn,
          className: data.user.className || 'Kelas 5-A',
          managedClass: data.user.managedClass || 'Kelas 5-A',
          studentId: data.user.studentId,
          token: data.accessToken,
        });
        setProfileName(data.user.name);
        setIsLoggingIn(false);
        return;
      }
    } catch (err) {
      console.warn('API fallback to local mode.');
    }

    setIsLoggingIn(false);
    if (loginEmail === 'admin@sdn08pagi.sch.id') {
      setCurrentUser({ id: 'u-1', name: 'Budi Santoso', email: loginEmail, role: 'ADMIN', token: 'jwt-token-admin' });
      setProfileName('Budi Santoso');
    } else if (loginEmail === 'bendahara@sdn08pagi.sch.id') {
      setCurrentUser({ id: 'u-2', name: 'Siti Rahma', email: loginEmail, role: 'TREASURER', token: 'jwt-token-treasurer' });
      setProfileName('Siti Rahma');
    } else if (loginEmail === 'korlas.5a@sdn08pagi.sch.id') {
      setCurrentUser({ id: 'u-7', name: 'Ibu Ratna (Korlas 5-A)', email: loginEmail, role: 'KORLAS', managedClass: 'Kelas 5-A', token: 'jwt-token-korlas' });
      setProfileName('Ibu Ratna (Korlas 5-A)');
    } else if (loginEmail === 'andi@sdn08pagi.sch.id') {
      setCurrentUser({ id: 'u-3', name: 'Andi Wijaya', email: loginEmail, role: 'STUDENT', nis: '20260501', nisn: '0051234567', className: 'Kelas 5-A', token: 'jwt-token-student' });
      setProfileName('Andi Wijaya');
    } else if (loginEmail === 'orangtua.andi@sdn08pagi.sch.id') {
      setCurrentUser({ id: 'u-6', name: 'Wali Murid Andi Wijaya', email: loginEmail, role: 'PARENT', studentId: 'u-3', nis: '20260501', nisn: '0051234567', className: 'Kelas 5-A', token: 'jwt-token-parent' });
      setProfileName('Wali Murid Andi Wijaya');
    } else {
      const foundUser = userAccounts.find((u) => u.email === loginEmail);
      if (foundUser) {
        setCurrentUser({
          id: foundUser.id,
          name: foundUser.name,
          email: foundUser.email,
          role: foundUser.role,
          nis: foundUser.nis,
          nisn: foundUser.nisn,
          className: foundUser.className || 'Kelas 5-A',
          managedClass: foundUser.managedClass || 'Kelas 5-A',
          studentId: foundUser.studentId,
          token: 'dynamic-jwt-token',
        });
        setProfileName(foundUser.name);
      } else {
        setLoginError('Email atau password tidak valid.');
      }
    }
  };

  const handleLogout = () => {
    setCurrentUser(null);
  };

  // Profile & Password Change Handler
  const handleUpdateProfile = (e: React.FormEvent) => {
    e.preventDefault();
    if (!currentUser) return;

    setCurrentUser({ ...currentUser, name: profileName });
    setUserAccounts(userAccounts.map((u) => (u.id === currentUser.id ? { ...u, name: profileName } : u)));
    setShowProfileModal(false);
    setOldPassword('');
    setNewPassword('');
    showToast('✓ Profil dan password Anda berhasil diperbarui!');
  };

  // Requirement 4: Direct Student Registration with Strict Korlas Class Validation
  const handleAddStudentDirect = (e: React.FormEvent) => {
    e.preventDefault();
    setStudentValidationError('');
    if (!studentNis || !studentNisn || !studentName) return;

    // Strict Class Validation for Korlas
    if (currentUser?.role === 'KORLAS' && currentUser.managedClass) {
      if (studentClass !== currentUser.managedClass) {
        setStudentValidationError(`⚠️ Sebagai Korlas ${currentUser.managedClass}, Anda hanya diperbolehkan mendaftarkan siswa untuk ${currentUser.managedClass}!`);
        return;
      }
    }

    const targetClass = (currentUser?.role === 'KORLAS' && currentUser.managedClass) ? currentUser.managedClass : studentClass;
    const studentEmailGenerated = studentEmail || `${studentNis}@sdn08pagi.sch.id`;

    const newStudentAccount: UserAccount = {
      id: `u-${Date.now()}`,
      name: studentName,
      email: studentEmailGenerated,
      role: 'STUDENT',
      nis: studentNis,
      nisn: studentNisn,
      className: targetClass,
      gender: studentGender,
      religion: studentReligion,
      status: 'ACTIVE',
    };

    setUserAccounts([...userAccounts, newStudentAccount]);
    showToast(`✓ Siswa '${studentName}' (${targetClass}) berhasil ditambahkan dan otomatis terbuat akun login!`);

    setStudentNis('');
    setStudentNisn('');
    setStudentName('');
    setStudentEmail('');
    setShowStudentModal(false);
  };

  // Admin Account Creation
  const handleCreateUser = (e: React.FormEvent) => {
    e.preventDefault();
    if (!newUserName || !newUserEmail) return;

    let linkedStudentName: string | undefined = undefined;
    if (newUserRole === 'PARENT' && selectedChildStudentId) {
      const child = userAccounts.find((u) => u.id === selectedChildStudentId);
      if (child) linkedStudentName = child.name;
    }

    const newUser: UserAccount = {
      id: `u-${Date.now()}`,
      name: newUserName,
      email: newUserEmail,
      role: newUserRole,
      managedClass: newUserRole === 'KORLAS' ? selectedKorlasClass : undefined,
      studentId: selectedChildStudentId || undefined,
      studentName: linkedStudentName,
      status: 'ACTIVE',
    };

    setUserAccounts([...userAccounts, newUser]);
    showToast(`✓ Akun '${newUserName}' (${newUserRole} - ${newUserRole === 'KORLAS' ? selectedKorlasClass : ''}) berhasil dibuat!`);

    setNewUserName('');
    setNewUserEmail('');
    setSelectedChildStudentId('');
    setShowUserModal(false);
  };

  // Requirement 1: Scheduled Dues Handler Strictly Isolated to Korlas Managed Class
  const handleSaveCronSchedule = (e: React.FormEvent) => {
    e.preventDefault();
    const studentsList = scopedStudents; // Strictly scoped to Korlas class
    const targetClass = currentUser?.role === 'KORLAS' && currentUser.managedClass ? currentUser.managedClass : 'Kelas 5-A';

    const newBillings: StudentBilling[] = studentsList.map((s) => ({
      id: `b-${Date.now()}-${s.id}`,
      studentId: s.id,
      nis: s.nis || '20260501',
      nisn: s.nisn || '0051234567',
      studentName: s.name,
      className: s.className || targetClass,
      schemeTitle: `${cronTitle} (Tgl ${cronDay})`,
      period: 'Agustus 2026',
      amountDue: cronAmount,
      amountPaid: 0,
      status: 'PENDING',
    }));

    setBillings([...billings, ...newBillings]);
    setShowScheduleModal(false);
    showToast(`⏰ Penjadwalan iuran otomatis (${targetClass}) aktif! Dihasilkan tagihan baru & email notifikasi dikirimkan ke ${studentsList.length} siswa!`);
  };

  // Requirement 2: Cash Income Mutation Handler Strictly Isolated to Korlas Class
  const handleRecordTransaction = (e: React.FormEvent) => {
    e.preventDefault();
    const numAmount = parseFloat(txnAmount);
    if (isNaN(numAmount) || numAmount <= 0) return;

    const categoryText = txnType === 'INCOME' ? `Pemasukan (${incomeSource})` : 'Pengeluaran Kas';
    const assignedClass = currentUser?.role === 'KORLAS' && currentUser.managedClass ? currentUser.managedClass : 'Kelas 5-A';

    const newTx: Transaction = {
      id: `tx-${Date.now()}`,
      type: txnType,
      category: categoryText,
      incomeSource: txnType === 'INCOME' ? incomeSource : undefined,
      description: txnDescription || (txnType === 'INCOME' ? `Setoran ${incomeSource}` : 'Pengeluaran Kas'),
      className: assignedClass,
      amount: numAmount,
      recordedBy: currentUser ? `${currentUser.name} (${currentUser.role})` : 'System',
      paymentMethod: payMethod,
      date: new Date().toISOString().replace('T', ' ').substring(0, 16),
    };

    setTransactions([newTx, ...transactions]);
    setTxnAmount('');
    setTxnDescription('');
    setShowTransactionModal(false);
    showToast(`✓ Mutasi kas '${newTx.description}' (${assignedClass}) berhasil dicatat di buku besar!`);
  };

  // Payment Settlement Handler
  const handleSettlePayment = (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedBilling) return;

    const timestamp = new Date().toISOString().replace('T', ' ').substring(0, 16);

    setBillings(
      billings.map((b) =>
        b.id === selectedBilling.id
          ? { ...b, amountPaid: b.amountDue, status: 'PAID', paidAt: timestamp, paymentMethod: payMethod }
          : b
      )
    );

    const newTx: Transaction = {
      id: `tx-${Date.now()}`,
      type: 'INCOME',
      category: 'Pemasukan (Iuran Kas Siswa)',
      incomeSource: 'Iuran Kas Siswa',
      description: `Pembayaran ${selectedBilling.schemeTitle} oleh ${selectedBilling.studentName} (NIS: ${selectedBilling.nis})`,
      className: selectedBilling.className || (currentUser?.role === 'KORLAS' ? currentUser.managedClass : 'Kelas 5-A'),
      amount: selectedBilling.amountDue,
      recordedBy: currentUser ? `${currentUser.name} (${currentUser.role})` : 'Bendahara',
      paymentMethod: payMethod,
      date: timestamp,
    };

    setTransactions([newTx, ...transactions]);
    setShowPayModal(false);
    setSelectedBilling(null);
    showToast(`✓ Pelunasan Rp ${selectedBilling.amountDue.toLocaleString('id-ID')} oleh ${selectedBilling.studentName} berhasil dicatat & Email Bukti Bayar Dikirim!`);
  };

  // PDF Export & Email Dialog Popup Handler
  const triggerPdfEmailDialog = (reportType: 'LEDGER' | 'REPORTS') => {
    setPdfReportType(reportType);
    setTargetEmail(currentUser?.email || 'admin@sdn08pagi.sch.id');
    setShowPdfEmailModal(true);
  };

  const handleExecutePdfAndSendEmail = (e: React.FormEvent) => {
    e.preventDefault();
    setShowPdfEmailModal(false);

    const targetScopeClass = currentUser?.role === 'KORLAS' && currentUser.managedClass ? currentUser.managedClass : 'Semua Kelas';

    const doc = new jsPDF();
    doc.setFontSize(16);
    doc.text('SD NEGERI 08 PAGI', 14, 15);
    doc.setFontSize(10);
    doc.text(`Laporan Keuangan Kas Sekolah - ${targetScopeClass} (T.A. 2026/2027)`, 14, 22);
    doc.text(`Tanggal Cetak: ${new Date().toLocaleString('id-ID')}`, 14, 28);
    doc.text(`Penerima Email Arsip: ${targetEmail}`, 14, 34);
    doc.line(14, 38, 196, 38);

    if (pdfReportType === 'LEDGER') {
      doc.text(`BUKU BESAR MUTASI KAS (${targetScopeClass.toUpperCase()})`, 14, 45);
      autoTable(doc, {
        startY: 50,
        head: [['Tipe', 'Kategori / Sumber', 'Keterangan', 'Kelas', 'Metode', 'Pencatat', 'Waktu', 'Jumlah']],
        body: scopedTransactions.map((t) => [
          t.type,
          t.category,
          t.description,
          t.className || 'Kelas 5-A',
          t.paymentMethod,
          t.recordedBy,
          t.date,
          `Rp ${t.amount.toLocaleString('id-ID')}`,
        ]),
      });
    } else {
      doc.text(`LAPORAN KELUNASAN IURAN SISWA (${targetScopeClass.toUpperCase()})`, 14, 45);
      autoTable(doc, {
        startY: 50,
        head: [['NIS', 'NISN', 'Nama Siswa', 'Kelas', 'Periode', 'Tagihan', 'Status', 'Waktu Bayar']],
        body: filteredBillings.map((b) => [
          b.nis,
          b.nisn,
          b.studentName,
          b.className || 'Kelas 5-A',
          b.period,
          `Rp ${b.amountDue.toLocaleString('id-ID')}`,
          b.status,
          b.paidAt || 'Belum ada setoran',
        ]),
      });
    }

    doc.save(`Laporan_Kas_${targetScopeClass.replace(/\s+/g, '_')}_${Date.now()}.pdf`);
    showToast(`📄 PDF Laporan dikirimkan ke email ${targetEmail} & file berhasil di-download!`);
  };

  // Filtered & Grouped Billings by Period & Status (Using Scoped Billings)
  const filteredBillings = scopedBillings.filter((b) => {
    const periodMatch = b.period === reportPeriodFilter || reportPeriodFilter === 'ALL';
    if (!periodMatch) return false;
    if (reportStatusFilter === 'PAID') return b.status === 'PAID';
    if (reportStatusFilter === 'PENDING') return b.status === 'PENDING';
    return true;
  });

  // Current logged in Student / Parent child info
  const targetStudentProfile = userAccounts.find((u) => {
    if (currentUser?.role === 'PARENT' && currentUser.studentId) {
      return u.id === currentUser.studentId;
    }
    return u.id === currentUser?.id || u.nis === currentUser?.nis;
  }) || {
    id: currentUser?.id || 'u-3',
    name: currentUser?.name || 'Andi Wijaya',
    email: currentUser?.email || 'andi@sdn08pagi.sch.id',
    role: 'STUDENT',
    nis: currentUser?.nis || '20260501',
    nisn: currentUser?.nisn || '0051234567',
    className: currentUser?.className || 'Kelas 5-A',
    gender: 'MALE',
    religion: 'ISLAM',
    status: 'ACTIVE',
  };

  const studentPersonalBillings = billings.filter((b) => {
    return b.studentId === targetStudentProfile.id || b.nis === targetStudentProfile.nis;
  });

  const registeredStudents = userAccounts.filter((u) => u.role === 'STUDENT');

  // ----------------------------------------------------
  // RENDER: Mandatory Login Screen
  // ----------------------------------------------------
  if (!currentUser) {
    return (
      <div className="min-h-screen bg-slate-50 flex items-center justify-center p-4">
        <div className="w-full max-w-md bg-white rounded-3xl border border-slate-200 shadow-xl p-8 space-y-6">
          <div className="text-center space-y-2">
            <div className="inline-flex h-14 w-14 rounded-2xl bg-indigo-600 items-center justify-center text-white font-bold text-2xl shadow-lg shadow-indigo-200">
              SD
            </div>
            <h1 className="text-2xl font-bold text-slate-900 mt-2">SD Negeri 08 PAGI</h1>
            <p className="text-xs text-slate-500">Sistem Keuangan Kas Sekolah & Multi-Tenancy Korlas</p>
          </div>

          {loginError && (
            <div className="p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 text-xs font-medium">
              ⚠️ {loginError}
            </div>
          )}

          <form onSubmit={handleLogin} className="space-y-4 text-xs">
            <div>
              <label className="block text-slate-700 font-semibold mb-1">Email Pengguna</label>
              <input
                type="email"
                required
                value={loginEmail}
                onChange={(e) => setLoginEmail(e.target.value)}
                className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              />
            </div>

            <div>
              <label className="block text-slate-700 font-semibold mb-1">Password</label>
              <input
                type="password"
                required
                value={loginPassword}
                onChange={(e) => setLoginPassword(e.target.value)}
                className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm"
              />
            </div>

            <button
              type="submit"
              disabled={isLoggingIn}
              className="w-full py-3.5 rounded-xl gradient-button-light font-semibold text-sm shadow-md transition-all hover:scale-[1.01] disabled:opacity-50"
            >
              {isLoggingIn ? 'Memverifikasi...' : 'Masuk ke Sistem'}
            </button>
          </form>

          {/* Quick Demo Selector */}
          <div className="pt-4 border-t border-slate-100 text-xs space-y-2">
            <p className="text-slate-400 font-medium text-center">Pilih Akun Demo Quick Login:</p>
            <div className="grid grid-cols-2 gap-2">
              <button
                onClick={() => { setLoginEmail('admin@sdn08pagi.sch.id'); setLoginPassword('Password123!'); }}
                className="p-2 rounded-lg bg-blue-50 text-blue-700 font-medium border border-blue-100 hover:bg-blue-100 text-[11px]"
              >
                1. Admin (All Classes)
              </button>
              <button
                onClick={() => { setLoginEmail('bendahara@sdn08pagi.sch.id'); setLoginPassword('Password123!'); }}
                className="p-2 rounded-lg bg-indigo-50 text-indigo-700 font-medium border border-indigo-100 hover:bg-indigo-100 text-[11px]"
              >
                2. Bendahara Sekolah
              </button>
              <button
                onClick={() => { setLoginEmail('korlas.5a@sdn08pagi.sch.id'); setLoginPassword('Password123!'); }}
                className="p-2 rounded-lg bg-purple-50 text-purple-700 font-medium border border-purple-100 hover:bg-purple-100 text-[11px]"
              >
                3. Korlas (Kelas 5-A)
              </button>
              <button
                onClick={() => { setLoginEmail('andi@sdn08pagi.sch.id'); setLoginPassword('Password123!'); }}
                className="p-2 rounded-lg bg-emerald-50 text-emerald-700 font-medium border border-emerald-100 hover:bg-emerald-100 text-[11px]"
              >
                4. Akun Siswa (Andi)
              </button>
            </div>
          </div>
        </div>
      </div>
    );
  }

  // ----------------------------------------------------
  // RENDER VIEW A: PORTAL SISWA & ORANG TUA
  // ----------------------------------------------------
  if (currentUser.role === 'STUDENT' || currentUser.role === 'PARENT') {
    return (
      <div className="min-h-screen bg-slate-50 text-slate-900 flex flex-col justify-between">
        <div>
          {/* Toast Notification */}
          {toastMessage && (
            <div className="fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl text-xs font-semibold border border-slate-700">
              📬 {toastMessage}
            </div>
          )}

          <header className="light-panel sticky top-0 z-40 px-6 py-4 flex items-center justify-between shadow-xs">
            <div className="flex items-center space-x-3">
              <div className="h-10 w-10 rounded-xl bg-emerald-600 flex items-center justify-center font-bold text-white text-lg shadow-md shadow-emerald-200">
                SD
              </div>
              <div>
                <h1 className="text-base font-bold text-slate-900">Portal Siswa & Orang Tua Murid</h1>
                <p className="text-xs text-slate-500">SD Negeri 08 PAGI • {targetStudentProfile.className || 'Kelas 5-A'}</p>
              </div>
            </div>

            <div className="flex items-center space-x-3">
              <button
                onClick={() => setShowProfileModal(true)}
                className="text-right hover:bg-slate-100 p-2 rounded-xl transition-colors border border-slate-200 bg-white"
              >
                <p className="text-xs font-bold text-slate-900">{currentUser.name} ⚙️</p>
                <span className="px-2 py-0.2 rounded text-[10px] font-semibold bg-emerald-50 text-emerald-700">
                  {currentUser.role === 'STUDENT' ? 'Akun Siswa' : 'Akun Orang Tua'}
                </span>
              </button>
              <button onClick={handleLogout} className="text-xs text-rose-600 font-semibold px-3 py-2 bg-rose-50 hover:bg-rose-100 rounded-xl transition-colors">
                Keluar
              </button>
            </div>
          </header>

          <main className="max-w-7xl mx-auto px-6 pt-8 space-y-6">
            {/* 2-Column Split Layout */}
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
              
              {/* LEFT COLUMN: Detailed Student Profile Card */}
              <div className="lg:col-span-4 space-y-6">
                <div className="light-card rounded-2xl p-6 bg-white border border-slate-200 shadow-md space-y-6">
                  <div className="text-center space-y-3 pb-6 border-b border-slate-100">
                    <div className="h-20 w-20 mx-auto rounded-full bg-gradient-to-tr from-emerald-500 to-indigo-600 flex items-center justify-center text-white text-2xl font-bold shadow-lg">
                      {targetStudentProfile.name.substring(0, 2).toUpperCase()}
                    </div>
                    <div>
                      <h2 className="text-lg font-extrabold text-slate-900">{targetStudentProfile.name}</h2>
                      <p className="text-xs font-bold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-full inline-block mt-1">
                        {targetStudentProfile.className || 'Kelas 5-A'}
                      </p>
                    </div>
                  </div>

                  <div className="space-y-4 text-xs">
                    <h3 className="text-xs font-bold uppercase text-slate-400 tracking-wider">Informasi Lengkap Siswa</h3>
                    
                    <div className="flex justify-between items-center py-1.5 border-b border-slate-50">
                      <span className="text-slate-500">NIS (Nomor Induk):</span>
                      <span className="font-mono font-bold text-slate-900">{targetStudentProfile.nis || '-'}</span>
                    </div>

                    <div className="flex justify-between items-center py-1.5 border-b border-slate-50">
                      <span className="text-slate-500">NISN (10 Digit):</span>
                      <span className="font-mono font-semibold text-slate-900">{targetStudentProfile.nisn || '-'}</span>
                    </div>

                    <div className="flex justify-between items-center py-1.5 border-b border-slate-50">
                      <span className="text-slate-500">Jenis Kelamin:</span>
                      <span className="font-semibold text-slate-900">{targetStudentProfile.gender === 'MALE' ? 'Laki-laki (L)' : 'Perempuan (P)'}</span>
                    </div>

                    <div className="flex justify-between items-center py-1.5 border-b border-slate-50">
                      <span className="text-slate-500">Agama:</span>
                      <span className="font-semibold text-slate-900">{targetStudentProfile.religion || '-'}</span>
                    </div>

                    <div className="flex justify-between items-center py-1.5 border-b border-slate-50">
                      <span className="text-slate-500">Email Akun:</span>
                      <span className="font-mono text-slate-800 text-[11px]">{targetStudentProfile.email}</span>
                    </div>

                    <div className="flex justify-between items-center py-1.5">
                      <span className="text-slate-500">Status Akun:</span>
                      <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700">AKTIF</span>
                    </div>
                  </div>

                  <button
                    onClick={() => setShowProfileModal(true)}
                    className="w-full py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs transition-colors"
                  >
                    ⚙️ Ubah Profil & Password Saya
                  </button>
                </div>
              </div>

              {/* RIGHT COLUMN: Interactive Tabbed Dues & History Dashboard */}
              <div className="lg:col-span-8 space-y-6">
                
                {/* Tab Controls */}
                <div className="flex space-x-3 border-b border-slate-200 pb-3">
                  <button
                    onClick={() => setPortalTab('CURRENT')}
                    className={`px-5 py-2.5 rounded-xl text-xs font-bold transition-all ${portalTab === 'CURRENT' ? 'bg-emerald-600 text-white shadow-md' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'}`}
                  >
                    💳 Tagihan Saat Ini & Pending ({studentPersonalBillings.filter(b => b.status === 'PENDING').length})
                  </button>
                  <button
                    onClick={() => setPortalTab('HISTORY')}
                    className={`px-5 py-2.5 rounded-xl text-xs font-bold transition-all ${portalTab === 'HISTORY' ? 'bg-indigo-600 text-white shadow-md' : 'bg-white text-slate-600 hover:bg-slate-100 border border-slate-200'}`}
                  >
                    📜 History Transaksi & Setoran ({studentPersonalBillings.length})
                  </button>
                </div>

                {/* TAB 1: TAGIHAN SAAT INI */}
                {portalTab === 'CURRENT' && (
                  <div className="light-card rounded-2xl p-6 bg-white border border-slate-200 shadow-md space-y-4">
                    <h3 className="text-base font-bold text-slate-900">Tagihan Iuran Aktif Siswa</h3>
                    
                    <div className="space-y-3">
                      {studentPersonalBillings.map((b) => (
                        <div key={b.id} className="p-5 rounded-2xl border border-slate-200 bg-slate-50/50 flex flex-wrap items-center justify-between gap-4 hover:border-indigo-200 transition-colors">
                          <div>
                            <span className="text-[10px] font-extrabold uppercase text-indigo-700 bg-indigo-100/80 px-2.5 py-1 rounded-md">
                              {b.schemeTitle} • {b.period}
                            </span>
                            <h4 className="text-xl font-black text-slate-900 mt-2">{formatIDR(b.amountDue)}</h4>
                            {b.paidAt ? (
                              <p className="text-xs font-semibold text-emerald-600 mt-1">🕒 Setor pada: {b.paidAt} ({b.paymentMethod})</p>
                            ) : (
                              <p className="text-xs text-amber-700 font-semibold mt-1">⏳ Silakan lakukan setoran ke Korlas / Bendahara</p>
                            )}
                          </div>

                          <div>
                            <span className={`px-4 py-2 rounded-xl text-xs font-black shadow-xs ${b.status === 'PAID' ? 'bg-emerald-600 text-white' : 'bg-amber-500 text-white'}`}>
                              {b.status === 'PAID' ? '✓ LUNAS' : '⏳ BELUM LUNAS'}
                            </span>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* TAB 2: HISTORY TRANSAKSI */}
                {portalTab === 'HISTORY' && (
                  <div className="light-card rounded-2xl p-6 bg-white border border-slate-200 shadow-md space-y-4">
                    <h3 className="text-base font-bold text-slate-900">Rekapitulasi History Setoran Pembayaran</h3>
                    <div className="overflow-x-auto">
                      <table className="w-full text-left text-xs text-slate-700">
                        <thead className="bg-slate-100 uppercase text-[10px] text-slate-500">
                          <tr>
                            <th className="p-3">Program Iuran</th>
                            <th className="p-3">Periode</th>
                            <th className="p-3 text-right">Nominal</th>
                            <th className="p-3 text-center">Status</th>
                            <th className="p-3">Metode Bayar</th>
                            <th className="p-3">Waktu Bayar</th>
                          </tr>
                        </thead>
                        <tbody className="divide-y divide-slate-100">
                          {studentPersonalBillings.map((b) => (
                            <tr key={b.id}>
                              <td className="p-3 font-bold text-slate-900">{b.schemeTitle}</td>
                              <td className="p-3 font-semibold text-indigo-700">{b.period}</td>
                              <td className="p-3 text-right font-black">{formatIDR(b.amountDue)}</td>
                              <td className="p-3 text-center">
                                <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${b.status === 'PAID' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'}`}>
                                  {b.status === 'PAID' ? 'LUNAS' : 'PENDING'}
                                </span>
                              </td>
                              <td className="p-3 text-slate-600">{b.paymentMethod || '-'}</td>
                              <td className="p-3 text-slate-500">{b.paidAt || 'Belum ada setoran'}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </main>
        </div>

        {/* User Application Footer */}
        <footer className="mt-12 py-6 border-t border-slate-200 text-center text-xs text-slate-500 bg-white">
          <p className="font-semibold text-slate-700">SD Negeri 08 PAGI • Sistem Informasi Keuangan Kas Sekolah</p>
          <p className="text-[11px] text-slate-400 mt-1">Developed by Uwais Syahdan Riano • Version 1.2.0 (Build 2026)</p>
        </footer>

        {/* Profile Modal */}
        {showProfileModal && (
          <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
            <div className="bg-white w-full max-w-lg p-6 rounded-2xl border border-slate-200 shadow-2xl space-y-5 max-h-[90vh] overflow-y-auto">
              <div className="flex justify-between items-center pb-3 border-b border-slate-100">
                <h3 className="text-base font-bold text-slate-900">Profil Saya & Ubah Password</h3>
                <button onClick={() => setShowProfileModal(false)} className="text-slate-400 text-lg">✕</button>
              </div>

              <div className="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs space-y-2">
                <h4 className="font-bold text-slate-900 mb-2">Informasi Siswa Bersangkutan</h4>
                <div className="grid grid-cols-2 gap-2 text-slate-700">
                  <div><span className="text-slate-400">NIS:</span> <strong className="text-indigo-600">{targetStudentProfile.nis || '-'}</strong></div>
                  <div><span className="text-slate-400">NISN:</span> <strong>{targetStudentProfile.nisn || '-'}</strong></div>
                  <div><span className="text-slate-400">Kelas:</span> <strong className="text-indigo-600">{targetStudentProfile.className || 'Kelas 5-A'}</strong></div>
                  <div><span className="text-slate-400">Agama:</span> <strong>{targetStudentProfile.religion || '-'}</strong></div>
                  <div><span className="text-slate-400">Jenis Kelamin:</span> <strong>{targetStudentProfile.gender === 'MALE' ? 'Laki-laki' : 'Perempuan'}</strong></div>
                  <div><span className="text-slate-400">Email:</span> <strong>{targetStudentProfile.email}</strong></div>
                </div>
              </div>

              <form onSubmit={handleUpdateProfile} className="space-y-4 text-xs">
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Nama Lengkap Pengguna</label>
                  <input type="text" required value={profileName} onChange={(e) => setProfileName(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
                </div>
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Password Saat Ini</label>
                  <input type="password" placeholder="Password Saat Ini" value={oldPassword} onChange={(e) => setOldPassword(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
                </div>
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Password Baru</label>
                  <input type="password" placeholder="Password Baru" value={newPassword} onChange={(e) => setNewPassword(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
                </div>

                <div className="flex space-x-3 pt-2">
                  <button type="button" onClick={() => setShowProfileModal(false)} className="flex-1 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-semibold">Batal</button>
                  <button type="submit" className="flex-1 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold shadow-md">Simpan Perubahan</button>
                </div>
              </form>
            </div>
          </div>
        )}
      </div>
    );
  }

  // ----------------------------------------------------
  // RENDER VIEW B: EXECUTIVE ADMIN, BENDAHARA & KORLAS (STRICT SCOPED DASHBOARD)
  // ----------------------------------------------------
  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 flex flex-col justify-between">
      <div>
        {/* Toast Notification */}
        {toastMessage && (
          <div className="fixed bottom-6 right-6 z-50 bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl text-xs font-semibold border border-slate-700">
            📬 {toastMessage}
          </div>
        )}

        {/* Light Top Navbar */}
        <header className="light-panel sticky top-0 z-40 px-6 py-4 flex flex-wrap items-center justify-between shadow-xs">
          <div className="flex items-center space-x-3">
            <div className="h-10 w-10 rounded-xl bg-indigo-600 flex items-center justify-center font-bold text-white text-lg shadow-md shadow-indigo-200">
              SD
            </div>
            <div>
              <h1 className="text-base font-bold gradient-text-light">SD Negeri 08 PAGI</h1>
              <p className="text-xs text-slate-500">
                Sistem Keuangan Kas Sekolah • {currentUser.role === 'KORLAS' ? `Korlas (${currentUser.managedClass})` : 'Multi-Kelas Master'}
              </p>
            </div>
          </div>

          <div className="flex items-center space-x-4 mt-3 sm:mt-0">
            <div className="flex items-center space-x-3 bg-white px-3.5 py-1.5 rounded-xl border border-slate-200 shadow-xs">
              <button
                onClick={() => setShowProfileModal(true)}
                className="text-right hover:bg-slate-50 p-1 rounded-lg transition-colors"
              >
                <p className="text-xs font-bold text-slate-900">{currentUser.name} ⚙️</p>
                <span className="inline-block px-2 py-0.2 rounded text-[10px] font-semibold bg-purple-50 text-purple-700">
                  Role: {currentUser.role} {currentUser.managedClass ? `(${currentUser.managedClass})` : ''}
                </span>
              </button>
              <button onClick={handleLogout} className="text-xs text-rose-600 hover:text-rose-700 font-semibold px-2.5 py-1 bg-rose-50 hover:bg-rose-100 rounded-lg transition-colors">
                Keluar
              </button>
            </div>
          </div>
        </header>

        {/* Main Container */}
        <main className="max-w-7xl mx-auto px-6 pt-8 space-y-8">
          {/* Banner Section */}
          <div className="light-card rounded-2xl p-8 relative overflow-hidden bg-white">
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-6 relative z-10">
              <div>
                <span className="text-xs font-semibold tracking-wider text-purple-700 uppercase bg-purple-50 px-3 py-1 rounded-full border border-purple-100">
                  SD Negeri 08 PAGI • {currentUser.role === 'KORLAS' ? `Cakupan Kas ${currentUser.managedClass}` : 'Semua Kelas'}
                </span>
                <h2 className="text-2xl font-bold text-slate-900 mt-2">
                  {currentUser.role === 'KORLAS' ? `Dashboard Korlas (${currentUser.managedClass})` : 'Manajemen Keuangan Kas & Multi-Tenancy'}
                </h2>
                <p className="text-xs text-slate-500 mt-1 max-w-xl">
                  {currentUser.role === 'KORLAS'
                    ? `Ringkasan kas, mutasi, dan tagihan diisolasi secara ketat khusus untuk ${currentUser.managedClass}.`
                    : 'Akses penuh administrator untuk melihat dan mengelola keuangan seluruh kelas.'}
                </p>
              </div>

              <div className="flex flex-wrap gap-2">
                <button onClick={() => setShowScheduleModal(true)} className="bg-amber-600 hover:bg-amber-700 text-white px-3.5 py-2.5 rounded-xl font-semibold text-xs shadow-md">
                  📅 Penjadwalan Iuran Otomatis ({currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Semua'})
                </button>

                {currentUser.role === 'ADMIN' && (
                  <button onClick={() => setShowUserModal(true)} className="bg-indigo-600 hover:bg-indigo-700 text-white px-3.5 py-2.5 rounded-xl font-semibold text-xs shadow-md">
                    + Tambah Account (Admin / Korlas)
                  </button>
                )}

                <button onClick={() => setShowTransactionModal(true)} className="gradient-button-light px-3.5 py-2.5 rounded-xl font-semibold text-xs shadow-md">
                  + Catat Mutasi Kas ({currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Umum'})
                </button>
              </div>
            </div>
          </div>

          {/* Navigation Tabs */}
          <div className="flex space-x-2 border-b border-slate-200 pb-3">
            <button onClick={() => setActiveTab('OVERVIEW')} className={`px-4 py-2 rounded-xl text-xs font-semibold ${activeTab === 'OVERVIEW' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100'}`}>
              📈 Ringkasan Kas
            </button>
            <button onClick={() => setActiveTab('LEDGER')} className={`px-4 py-2 rounded-xl text-xs font-semibold ${activeTab === 'LEDGER' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100'}`}>
              📊 Buku Besar Mutasi ({scopedTransactions.length})
            </button>
            <button onClick={() => setActiveTab('STUDENTS')} className={`px-4 py-2 rounded-xl text-xs font-semibold ${activeTab === 'STUDENTS' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100'}`}>
              🎓 Data Siswa Terdaftar ({scopedStudents.length})
            </button>
            <button onClick={() => setActiveTab('REPORTS')} className={`px-4 py-2 rounded-xl text-xs font-semibold ${activeTab === 'REPORTS' ? 'bg-emerald-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100'}`}>
              📋 Menu Laporan Iuran Siswa
            </button>
            {currentUser.role === 'ADMIN' && (
              <button onClick={() => setActiveTab('USERS')} className={`px-4 py-2 rounded-xl text-xs font-semibold ${activeTab === 'USERS' ? 'bg-blue-600 text-white shadow-md' : 'text-slate-600 hover:bg-slate-100'}`}>
                👥 Account Management ({userAccounts.length})
              </button>
            )}
          </div>

          {/* TAB 1: OVERVIEW (Requirement 3: Strictly Scoped Class Metrics) */}
          {activeTab === 'OVERVIEW' && (
            <div className="space-y-6">
              <div className="grid grid-cols-1 md:grid-cols-4 gap-6">
                <div className="light-card p-6 rounded-2xl">
                  <p className="text-xs font-medium text-slate-500 uppercase">Saldo Kas ({currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Utama'})</p>
                  <h3 className="text-2xl font-extrabold mt-2 text-slate-900">{formatIDR(computedBalance)}</h3>
                </div>
                <div className="light-card p-6 rounded-2xl">
                  <p className="text-xs font-medium text-slate-500 uppercase">Capaian Pembayaran</p>
                  <h3 className="text-2xl font-extrabold mt-2 text-indigo-600">{computedCollectionRate}%</h3>
                </div>
                <div className="light-card p-6 rounded-2xl">
                  <p className="text-xs font-medium text-slate-500 uppercase">Total Terkumpul</p>
                  <h3 className="text-2xl font-extrabold mt-2 text-emerald-600">{formatIDR(totalDuesCollected)}</h3>
                </div>
                <div className="light-card p-6 rounded-2xl">
                  <p className="text-xs font-medium text-slate-500 uppercase">Tunggakan Pending</p>
                  <h3 className="text-2xl font-extrabold mt-2 text-amber-600">{formatIDR(totalPendingDues)}</h3>
                </div>
              </div>

              <div className="light-card rounded-2xl p-6 space-y-4">
                <h3 className="text-base font-bold text-slate-900">Mutasi Kas Terkategori Terbaru ({currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Semua Kelas'})</h3>
                <div className="overflow-x-auto">
                  <table className="w-full text-left text-xs text-slate-700">
                    <thead className="bg-slate-100 uppercase text-[10px] text-slate-500">
                      <tr>
                        <th className="p-3">Tipe</th>
                        <th className="p-3">Kategori / Sumber Asal</th>
                        <th className="p-3">Keterangan</th>
                        <th className="p-3">Kelas</th>
                        <th className="p-3">Waktu</th>
                        <th className="p-3 text-right">Jumlah</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-100">
                      {scopedTransactions.map((tx) => (
                        <tr key={tx.id}>
                          <td className="p-3">
                            <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${tx.type === 'INCOME' ? 'bg-emerald-50 text-emerald-700' : 'bg-rose-50 text-rose-700'}`}>
                              {tx.type}
                            </span>
                          </td>
                          <td className="p-3 font-semibold text-slate-900">{tx.category}</td>
                          <td className="p-3 text-slate-600">{tx.description}</td>
                          <td className="p-3 font-bold text-indigo-600">{tx.className || 'Kelas 5-A'}</td>
                          <td className="p-3 text-slate-500">{tx.date}</td>
                          <td className={`p-3 text-right font-bold ${tx.type === 'INCOME' ? 'text-emerald-600' : 'text-rose-600'}`}>
                            {tx.type === 'INCOME' ? '+' : '-'}{formatIDR(tx.amount)}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          )}

          {/* TAB 2: LEDGER */}
          {activeTab === 'LEDGER' && (
            <div className="light-card rounded-2xl p-6 space-y-4">
              <div className="flex justify-between items-center pb-3 border-b border-slate-100">
                <h3 className="text-lg font-bold text-slate-900">Buku Besar Mutasi Kas ({currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Semua Kelas'})</h3>
                <button onClick={() => triggerPdfEmailDialog('LEDGER')} className="bg-indigo-600 text-white px-3.5 py-1.5 rounded-xl text-xs font-semibold shadow-xs">
                  📄 Export PDF & Kirim Email Laporan
                </button>
              </div>
              <div className="overflow-x-auto">
                <table className="w-full text-left text-xs text-slate-700">
                  <thead className="bg-slate-100 uppercase text-[10px] text-slate-500">
                    <tr>
                      <th className="p-3">Tipe</th>
                      <th className="p-3">Kategori / Sumber Asal</th>
                      <th className="p-3">Keterangan</th>
                      <th className="p-3">Kelas</th>
                      <th className="p-3">Metode</th>
                      <th className="p-3">Waktu</th>
                      <th className="p-3 text-right">Jumlah</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {scopedTransactions.map((tx) => (
                      <tr key={tx.id}>
                        <td className="p-3 font-bold">{tx.type}</td>
                        <td className="p-3 font-semibold text-indigo-700">{tx.category}</td>
                        <td className="p-3">{tx.description}</td>
                        <td className="p-3 font-bold text-indigo-600">{tx.className || 'Kelas 5-A'}</td>
                        <td className="p-3">{tx.paymentMethod}</td>
                        <td className="p-3">{tx.date}</td>
                        <td className="p-3 text-right font-bold">{formatIDR(tx.amount)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* TAB 3: STUDENTS DIRECTORY */}
          {activeTab === 'STUDENTS' && (
            <div className="light-card rounded-2xl p-6 space-y-4">
              <div className="flex justify-between items-center pb-3 border-b border-slate-100">
                <div>
                  <h3 className="text-lg font-bold text-slate-900">Direktori Siswa Terdaftar ({currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Semua Kelas'})</h3>
                  <p className="text-xs text-indigo-600 font-semibold">💡 Klik nama siswa untuk melihat detail informasi & history pembayaran siswa tersebut</p>
                </div>
                <button
                  onClick={() => {
                    if (currentUser.role === 'KORLAS' && currentUser.managedClass) {
                      setStudentClass(currentUser.managedClass);
                    }
                    setShowStudentModal(true);
                  }}
                  className="bg-emerald-600 text-white px-4 py-2 rounded-xl text-xs font-semibold shadow-md"
                >
                  + Tambah Siswa Baru ({currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Auto Generate Account'})
                </button>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full text-left text-xs text-slate-700">
                  <thead className="bg-slate-100 uppercase text-[10px] text-slate-500">
                    <tr>
                      <th className="p-3">NIS</th>
                      <th className="p-3">NISN</th>
                      <th className="p-3">Nama Siswa (Klik Detail)</th>
                      <th className="p-3">Kelas</th>
                      <th className="p-3">Jenis Kelamin</th>
                      <th className="p-3">Agama</th>
                      <th className="p-3">Email Login Siswa</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {scopedStudents.map((s) => (
                      <tr
                        key={s.id}
                        onClick={() => { setSelectedStudentDetail(s); setShowStudentDetailModal(true); }}
                        className="hover:bg-indigo-50 cursor-pointer transition-colors"
                      >
                        <td className="p-3 font-mono font-semibold text-indigo-600">{s.nis || '-'}</td>
                        <td className="p-3 font-mono text-slate-500">{s.nisn || '-'}</td>
                        <td className="p-3 font-bold text-indigo-900 underline">{s.name} 🔍</td>
                        <td className="p-3 font-bold text-indigo-600">{s.className || 'Kelas 5-A'}</td>
                        <td className="p-3">{s.gender === 'MALE' ? 'Laki-laki (L)' : 'Perempuan (P)'}</td>
                        <td className="p-3">{s.religion || '-'}</td>
                        <td className="p-3 text-slate-500 font-mono">{s.email}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* TAB 4: REPORTS */}
          {activeTab === 'REPORTS' && (
            <div className="light-card rounded-2xl p-6 space-y-6">
              <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-3 border-b border-slate-100">
                <div>
                  <h3 className="text-lg font-bold text-slate-900">Laporan Kelunasan Iuran Siswa ({currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Semua Kelas'})</h3>
                  <p className="text-xs text-slate-500">Rekapitulasi tagihan per periode bulan dan history setoran siswa</p>
                </div>

                <div className="flex flex-wrap gap-2 items-center">
                  <select
                    value={reportPeriodFilter}
                    onChange={(e) => setReportPeriodFilter(e.target.value)}
                    className="bg-slate-100 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-semibold"
                  >
                    <option value="Agustus 2026">Periode: Agustus 2026</option>
                    <option value="September 2026">Periode: September 2026</option>
                    <option value="ALL">Semua Periode Bulan</option>
                  </select>

                  <div className="flex bg-slate-100 p-1 rounded-xl text-xs">
                    <button onClick={() => setReportStatusFilter('ALL')} className={`px-3 py-1 rounded-lg ${reportStatusFilter === 'ALL' ? 'bg-white font-bold' : ''}`}>Semua</button>
                    <button onClick={() => setReportStatusFilter('PAID')} className={`px-3 py-1 rounded-lg ${reportStatusFilter === 'PAID' ? 'bg-emerald-600 text-white font-bold' : ''}`}>Lunas</button>
                    <button onClick={() => setReportStatusFilter('PENDING')} className={`px-3 py-1 rounded-lg ${reportStatusFilter === 'PENDING' ? 'bg-amber-600 text-white font-bold' : ''}`}>Belum Lunas</button>
                  </div>

                  <button onClick={() => triggerPdfEmailDialog('REPORTS')} className="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-xl text-xs font-semibold shadow-md">
                    📄 Export PDF & Kirim Email
                  </button>
                </div>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full text-left text-xs text-slate-700">
                  <thead className="bg-slate-100 uppercase text-[10px] text-slate-500">
                    <tr>
                      <th className="p-3">NIS</th>
                      <th className="p-3">NISN</th>
                      <th className="p-3">Nama Siswa</th>
                      <th className="p-3">Kelas</th>
                      <th className="p-3">Periode</th>
                      <th className="p-3 text-right">Tagihan</th>
                      <th className="p-3 text-center">Status</th>
                      <th className="p-3">Waktu Bayar</th>
                      <th className="p-3 text-center">Aksi</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {filteredBillings.map((b) => (
                      <tr key={b.id}>
                        <td className="p-3 font-mono font-semibold text-indigo-600">{b.nis}</td>
                        <td className="p-3 font-mono text-slate-500">{b.nisn}</td>
                        <td className="p-3 font-bold text-slate-900">{b.studentName}</td>
                        <td className="p-3 font-bold text-indigo-600">{b.className || 'Kelas 5-A'}</td>
                        <td className="p-3 font-semibold text-slate-700">{b.period}</td>
                        <td className="p-3 text-right font-bold">{formatIDR(b.amountDue)}</td>
                        <td className="p-3 text-center">
                          <span className={`px-2.5 py-1 rounded text-[10px] font-bold ${b.status === 'PAID' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'}`}>
                            {b.status === 'PAID' ? 'LUNAS' : 'BELUM LUNAS'}
                          </span>
                        </td>
                        <td className="p-3 text-slate-500">{b.paidAt || 'Belum ada setoran'}</td>
                        <td className="p-3 text-center">
                          {b.status === 'PENDING' && (
                            <button onClick={() => { setSelectedBilling(b); setShowPayModal(true); }} className="bg-emerald-600 text-white px-2.5 py-1 rounded-lg text-[11px] font-semibold">
                              Catat Pelunasan
                            </button>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}

          {/* TAB 5: ACCOUNT MANAGEMENT */}
          {activeTab === 'USERS' && currentUser.role === 'ADMIN' && (
            <div className="light-card rounded-2xl p-6 space-y-6">
              <div className="flex justify-between items-center pb-3 border-b border-slate-100">
                <div>
                  <h3 className="text-lg font-bold text-slate-900">Account Management</h3>
                  <p className="text-xs text-slate-500">Pendaftaran akun Admin, Bendahara, Korlas, dan Orang Tua Siswa</p>
                </div>
                <button onClick={() => setShowUserModal(true)} className="bg-indigo-600 text-white px-4 py-2 rounded-xl text-xs font-semibold">
                  + Tambah Account (Admin / Bendahara / Korlas / Parent)
                </button>
              </div>
              <div className="overflow-x-auto">
                <table className="w-full text-left text-xs text-slate-700">
                  <thead className="bg-slate-100 uppercase text-[10px] text-slate-500">
                    <tr>
                      <th className="p-3">Nama</th>
                      <th className="p-3">Email</th>
                      <th className="p-3">Role</th>
                      <th className="p-3">Cakupan Kelas / Anak</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {userAccounts.map((u) => (
                      <tr key={u.id}>
                        <td className="p-3 font-bold">{u.name}</td>
                        <td className="p-3">{u.email}</td>
                        <td className="p-3"><span className="font-bold text-indigo-700">{u.role}</span></td>
                        <td className="p-3 font-semibold text-slate-800">
                          {u.role === 'KORLAS' ? `📌 Korlas: ${u.managedClass || 'Kelas 5-A'}` : u.studentName ? `👨‍👦 Anak: ${u.studentName}` : u.nis ? `NIS: ${u.nis}` : '-'}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </main>
      </div>

      {/* User Application Footer */}
      <footer className="mt-12 py-6 border-t border-slate-200 text-center text-xs text-slate-500 bg-white">
        <p className="font-semibold text-slate-700">SD Negeri 08 PAGI • Sistem Informasi Keuangan Kas Sekolah</p>
        <p className="text-[11px] text-slate-400 mt-1">Developed by Uwais Syahdan Riano • Version 1.2.0 (Build 2026)</p>
      </footer>

      {/* Modal 1: Email PDF Dialog Popup */}
      {showPdfEmailModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
          <div className="bg-white w-full max-w-md p-6 rounded-2xl border border-slate-200 shadow-2xl space-y-4">
            <div className="flex justify-between items-center pb-3 border-b border-slate-100">
              <h3 className="text-base font-bold text-slate-900">📄 Export PDF & Kirim Laporan ke Email</h3>
              <button onClick={() => setShowPdfEmailModal(false)} className="text-slate-400 text-lg">✕</button>
            </div>

            <form onSubmit={handleExecutePdfAndSendEmail} className="space-y-4 text-xs">
              <div>
                <label className="block text-slate-700 font-semibold mb-1">Email Tujuan Penerima Laporan PDF</label>
                <input
                  type="email"
                  required
                  placeholder="admin@sdn08pagi.sch.id"
                  value={targetEmail}
                  onChange={(e) => setTargetEmail(e.target.value)}
                  className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
                />
              </div>

              <div className="p-3 bg-indigo-50 border border-indigo-200 rounded-xl text-[11px] text-indigo-900">
                📧 <strong>Format Email Rapi:</strong> Sistem akan mengunduh dokumen PDF secara lokal dan sekaligus mendistribusikan email laporan berformat HTML lengkap beserta lampiran PDF ke email yang dimasukkan.
              </div>

              <div className="flex space-x-3 pt-2">
                <button type="button" onClick={() => setShowPdfEmailModal(false)} className="flex-1 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-semibold">Batal</button>
                <button type="submit" className="flex-1 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold shadow-md">Kirim Email & Download PDF</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal 2: Student Detail & Payment History Modal */}
      {showStudentDetailModal && selectedStudentDetail && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
          <div className="bg-white w-full max-w-2xl p-6 rounded-2xl border border-slate-200 shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">
            <div className="flex justify-between items-center pb-3 border-b border-slate-100">
              <div>
                <h3 className="text-lg font-bold text-slate-900">Detail Informasi & Rekapitulasi Siswa</h3>
                <p className="text-xs text-slate-500">{selectedStudentDetail.name} • {selectedStudentDetail.className || 'Kelas 5-A'}</p>
              </div>
              <button onClick={() => setShowStudentDetailModal(false)} className="text-slate-400 text-lg">✕</button>
            </div>

            <div className="grid grid-cols-2 gap-4 p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs">
              <div><p className="text-slate-500">NIS:</p><p className="font-mono font-bold text-indigo-600">{selectedStudentDetail.nis || '-'}</p></div>
              <div><p className="text-slate-500">NISN:</p><p className="font-mono font-semibold">{selectedStudentDetail.nisn || '-'}</p></div>
              <div><p className="text-slate-500">Kelas:</p><p className="font-bold text-indigo-600">{selectedStudentDetail.className || 'Kelas 5-A'}</p></div>
              <div><p className="text-slate-500">Agama:</p><p className="font-semibold">{selectedStudentDetail.religion || '-'}</p></div>
              <div><p className="text-slate-500">Jenis Kelamin:</p><p className="font-semibold">{selectedStudentDetail.gender === 'MALE' ? 'Laki-laki (L)' : 'Perempuan (P)'}</p></div>
              <div><p className="text-slate-500">Email Login:</p><p className="font-mono text-slate-800 text-[11px]">{selectedStudentDetail.email}</p></div>
            </div>

            {/* History Payments for this student */}
            <div className="space-y-3">
              <h4 className="text-sm font-bold text-slate-900">Riwayat Pembayaran & Dues Siswa Ini</h4>
              <div className="overflow-x-auto">
                <table className="w-full text-left text-xs text-slate-700">
                  <thead className="bg-slate-100 uppercase text-[10px] text-slate-500">
                    <tr>
                      <th className="p-2.5">Program Iuran</th>
                      <th className="p-2.5">Periode</th>
                      <th className="p-2.5 text-right">Tagihan</th>
                      <th className="p-2.5 text-center">Status</th>
                      <th className="p-2.5">Waktu Setor</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100">
                    {billings.filter(b => b.studentId === selectedStudentDetail.id || b.nis === selectedStudentDetail.nis).map((b) => (
                      <tr key={b.id}>
                        <td className="p-2.5 font-semibold text-slate-900">{b.schemeTitle}</td>
                        <td className="p-2.5 text-slate-600">{b.period}</td>
                        <td className="p-2.5 text-right font-bold">{formatIDR(b.amountDue)}</td>
                        <td className="p-2.5 text-center">
                          <span className={`px-2 py-0.5 rounded text-[10px] font-bold ${b.status === 'PAID' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'}`}>
                            {b.status === 'PAID' ? 'LUNAS' : 'PENDING'}
                          </span>
                        </td>
                        <td className="p-2.5 text-slate-500">{b.paidAt || '-'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <div className="text-right">
              <button onClick={() => setShowStudentDetailModal(false)} className="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 text-xs font-semibold">Tutup</button>
            </div>
          </div>
        </div>
      )}

      {/* Modal 3: Profile Change Password */}
      {showProfileModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
          <div className="bg-white w-full max-w-md p-6 rounded-2xl border border-slate-200 shadow-2xl space-y-4">
            <div className="flex justify-between items-center pb-3 border-b border-slate-100">
              <h3 className="text-base font-bold text-slate-900">Profil Saya & Ubah Password</h3>
              <button onClick={() => setShowProfileModal(false)} className="text-slate-400 text-lg">✕</button>
            </div>

            <form onSubmit={handleUpdateProfile} className="space-y-4 text-xs">
              <div>
                <label className="block text-slate-700 font-semibold mb-1">Nama Pengguna</label>
                <input type="text" required value={profileName} onChange={(e) => setProfileName(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
              </div>
              <div>
                <label className="block text-slate-700 font-semibold mb-1">Email</label>
                <input type="email" disabled value={currentUser.email} className="w-full bg-slate-100 border border-slate-200 rounded-xl p-3 text-slate-500 text-sm" />
              </div>
              <div>
                <label className="block text-slate-700 font-semibold mb-1">Password Saat Ini</label>
                <input type="password" placeholder="Password Saat Ini" value={oldPassword} onChange={(e) => setOldPassword(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
              </div>
              <div>
                <label className="block text-slate-700 font-semibold mb-1">Password Baru</label>
                <input type="password" placeholder="Password Baru" value={newPassword} onChange={(e) => setNewPassword(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
              </div>

              <div className="flex space-x-3 pt-2">
                <button type="button" onClick={() => setShowProfileModal(false)} className="flex-1 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-semibold">Batal</button>
                <button type="submit" className="flex-1 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold shadow-md">Simpan Perubahan</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal 4: Student Direct Registration Modal (Requirement 4: Strict Class Validation for Korlas) */}
      {showStudentModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
          <div className="bg-white w-full max-w-lg p-6 rounded-2xl border border-slate-200 shadow-2xl space-y-4">
            <div className="flex justify-between items-center pb-3 border-b border-slate-100">
              <h3 className="text-base font-bold text-slate-900">
                Tambah Siswa Baru {currentUser.role === 'KORLAS' ? `(${currentUser.managedClass})` : '(Auto Generate Account)'}
              </h3>
              <button onClick={() => { setShowStudentModal(false); setStudentValidationError(''); }} className="text-slate-400 text-lg">✕</button>
            </div>

            {studentValidationError && (
              <div className="p-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 text-xs font-semibold">
                {studentValidationError}
              </div>
            )}

            <form onSubmit={handleAddStudentDirect} className="space-y-4 text-xs">
              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">NIS</label>
                  <input type="text" required placeholder="20260505" value={studentNis} onChange={(e) => setStudentNis(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
                </div>
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">NISN (10 Digit)</label>
                  <input type="text" required maxLength={10} placeholder="0051234572" value={studentNisn} onChange={(e) => setStudentNisn(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
                </div>
              </div>

              <div>
                <label className="block text-slate-700 font-semibold mb-1">Nama Lengkap Siswa</label>
                <input type="text" required placeholder="Nama Lengkap" value={studentName} onChange={(e) => setStudentName(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
              </div>

              <div className="grid grid-cols-3 gap-3">
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Kelas</label>
                  <input
                    type="text"
                    required
                    disabled={currentUser.role === 'KORLAS'}
                    placeholder="Kelas 5-A"
                    list="kelas-options"
                    value={currentUser.role === 'KORLAS' && currentUser.managedClass ? currentUser.managedClass : studentClass}
                    onChange={(e) => setStudentClass(e.target.value)}
                    className={`w-full border rounded-xl p-3 text-sm font-semibold ${currentUser.role === 'KORLAS' ? 'bg-slate-100 border-slate-200 text-slate-500' : 'bg-slate-50 border-slate-300 text-slate-900'}`}
                  />
                  {currentUser.role !== 'KORLAS' && (
                    <datalist id="kelas-options">
                      {['1', '2', '3', '4', '5', '6'].flatMap((g) =>
                        ['A', 'B', 'C', 'D', 'E', 'F'].map((s) => `Kelas ${g}-${s}`)
                      ).map((cls) => (
                        <option key={cls} value={cls} />
                      ))}
                    </datalist>
                  )}
                </div>
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Jenis Kelamin</label>
                  <select value={studentGender} onChange={(e) => setStudentGender(e.target.value as any)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm">
                    <option value="MALE">Laki-laki</option>
                    <option value="FEMALE">Perempuan</option>
                  </select>
                </div>
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Agama</label>
                  <select value={studentReligion} onChange={(e) => setStudentReligion(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm">
                    <option value="ISLAM">ISLAM</option>
                    <option value="CHRISTIAN">KRISTEN</option>
                    <option value="CATHOLIC">KATOLIK</option>
                    <option value="HINDU">HINDU</option>
                    <option value="BUDDHA">BUDDHA</option>
                  </select>
                </div>
              </div>

              <div>
                <label className="block text-slate-700 font-semibold mb-1">Email Login Siswa</label>
                <input type="email" placeholder="siswa@sdn08pagi.sch.id" value={studentEmail} onChange={(e) => setStudentEmail(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
              </div>

              <div className="flex space-x-3 pt-2">
                <button type="button" onClick={() => { setShowStudentModal(false); setStudentValidationError(''); }} className="flex-1 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-semibold">Batal</button>
                <button type="submit" className="flex-1 py-2.5 rounded-xl bg-emerald-600 text-white font-semibold shadow-md">Simpan & Buat Akun Login</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal 5: Categorized Cash Income Mutation (Requirement 2: Locked to Korlas Managed Class) */}
      {showTransactionModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
          <div className="bg-white w-full max-w-md p-6 rounded-2xl border border-slate-200 shadow-2xl space-y-4">
            <div className="flex justify-between items-center pb-3 border-b border-slate-100">
              <h3 className="text-base font-bold text-slate-900">Catat Mutasi Kas ({currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Kelas'})</h3>
              <button onClick={() => setShowTransactionModal(false)} className="text-slate-400 text-lg">✕</button>
            </div>

            <form onSubmit={handleRecordTransaction} className="space-y-4 text-xs">
              <div>
                <label className="block text-slate-700 font-semibold mb-1">Tipe Mutasi</label>
                <div className="grid grid-cols-2 gap-2">
                  <button type="button" onClick={() => setTxnType('INCOME')} className={`py-2 rounded-xl font-semibold border ${txnType === 'INCOME' ? 'bg-emerald-600 text-white border-emerald-600' : 'bg-slate-50 text-slate-600'}`}>+ Pemasukan</button>
                  <button type="button" onClick={() => setTxnType('EXPENSE')} className={`py-2 rounded-xl font-semibold border ${txnType === 'EXPENSE' ? 'bg-rose-600 text-white border-rose-600' : 'bg-slate-50 text-slate-600'}`}>- Pengeluaran</button>
                </div>
              </div>

              {txnType === 'INCOME' && (
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Sumber Asal Pemasukan</label>
                  <select value={incomeSource} onChange={(e) => setIncomeSource(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm font-semibold">
                    <option value="Iuran Kas Siswa">1. Iuran Kas Siswa</option>
                    <option value="Sumbangan / Donasi Orang Tua">2. Sumbangan / Donasi Orang Tua</option>
                    <option value="Dana Bantuan / Sponsor">3. Dana Bantuan Sekolah / Sponsor</option>
                    <option value="Hasil Bazzar / Event Kelas">4. Hasil Bazzar / Event Kelas</option>
                    <option value="Lain-lain">5. Lain-lain</option>
                  </select>
                </div>
              )}

              <div>
                <label className="block text-slate-700 font-semibold mb-1">Jumlah (IDR)</label>
                <input type="number" required placeholder="25000" value={txnAmount} onChange={(e) => setTxnAmount(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
              </div>

              <div>
                <label className="block text-slate-700 font-semibold mb-1">Keterangan Detail</label>
                <textarea rows={3} placeholder="Detail mutasi kas..." value={txnDescription} onChange={(e) => setTxnDescription(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm"></textarea>
              </div>

              <div className="flex space-x-3 pt-2">
                <button type="button" onClick={() => setShowTransactionModal(false)} className="flex-1 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-semibold">Batal</button>
                <button type="submit" className="flex-1 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold shadow-md">Simpan Mutasi Kas</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal 6: Automated Cron Dues Scheduler (Requirement 1: Locked to Korlas Managed Class) */}
      {showScheduleModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
          <div className="bg-white w-full max-w-md p-6 rounded-2xl border border-slate-200 shadow-2xl space-y-4">
            <div className="flex justify-between items-center pb-3 border-b border-slate-100">
              <h3 className="text-base font-bold text-slate-900">📅 Penjadwalan Iuran Otomatis ({currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Multi-Kelas'})</h3>
              <button onClick={() => setShowScheduleModal(false)} className="text-slate-400 text-lg">✕</button>
            </div>

            <form onSubmit={handleSaveCronSchedule} className="space-y-4 text-xs">
              <div>
                <label className="block text-slate-700 font-semibold mb-1">Program Iuran Wajib</label>
                <input type="text" required value={cronTitle} onChange={(e) => setCronTitle(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Tanggal Eksekusi Rutin</label>
                  <select value={cronDay} onChange={(e) => setCronDay(parseInt(e.target.value))} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm">
                    <option value={1}>Setiap Tanggal 1</option>
                    <option value={5}>Setiap Tanggal 5</option>
                    <option value={10}>Setiap Tanggal 10</option>
                  </select>
                </div>
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Nominal (IDR)</label>
                  <input type="number" required value={cronAmount} onChange={(e) => setCronAmount(parseInt(e.target.value))} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
                </div>
              </div>

              <div className="p-3 bg-purple-50 border border-purple-200 rounded-xl text-[11px] text-purple-900">
                🔒 <strong>Isolasi Korlas:</strong> Tagihan otomatis ini hanya akan dihasilkan secara terbatas untuk siswa di <strong>{currentUser.role === 'KORLAS' ? currentUser.managedClass : 'Kelas Anda'}</strong> tanpa mempengaruhi jadwal kelas lain.
              </div>

              <div className="flex space-x-3 pt-2">
                <button type="button" onClick={() => setShowScheduleModal(false)} className="flex-1 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-semibold">Batal</button>
                <button type="submit" className="flex-1 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-semibold shadow-md">Simpan Cron</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal 7: Admin Add User Modal */}
      {showUserModal && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
          <div className="bg-white w-full max-w-lg p-6 rounded-2xl border border-slate-200 shadow-2xl space-y-4">
            <div className="flex justify-between items-center pb-3 border-b border-slate-100">
              <h3 className="text-base font-bold text-slate-900">Tambah Account Management</h3>
              <button onClick={() => setShowUserModal(false)} className="text-slate-400 text-lg">✕</button>
            </div>

            <form onSubmit={handleCreateUser} className="space-y-4 text-xs">
              <div>
                <label className="block text-slate-700 font-semibold mb-1">Nama Lengkap</label>
                <input type="text" required placeholder="Nama User / Korlas" value={newUserName} onChange={(e) => setNewUserName(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
              </div>

              <div>
                <label className="block text-slate-700 font-semibold mb-1">Email Pengguna</label>
                <input type="email" required placeholder="user@sdn08pagi.sch.id" value={newUserEmail} onChange={(e) => setNewUserEmail(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Role / Hak Akses</label>
                  <select value={newUserRole} onChange={(e) => setNewUserRole(e.target.value as any)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm font-semibold">
                    <option value="KORLAS">KORLAS (Koordinator Kelas)</option>
                    <option value="TREASURER">TREASURER (Bendahara Sekolah)</option>
                    <option value="PARENT">PARENT (Orang Tua Murid)</option>
                    <option value="ADMIN">ADMIN (Administrator)</option>
                  </select>
                </div>
                <div>
                  <label className="block text-slate-700 font-semibold mb-1">Password</label>
                  <input type="password" required value={newUserPassword} onChange={(e) => setNewUserPassword(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm" />
                </div>
              </div>

              {newUserRole === 'KORLAS' && (
                <div className="p-3.5 bg-purple-50 border border-purple-200 rounded-xl space-y-2">
                  <label className="block text-purple-900 font-bold">📌 Pilih Kelas yang Dikelola oleh Korlas Ini</label>
                  <input
                    type="text"
                    required
                    placeholder="Kelas 5-A"
                    list="korlas-kelas-list"
                    value={selectedKorlasClass}
                    onChange={(e) => setSelectedKorlasClass(e.target.value)}
                    className="w-full bg-white border border-purple-300 rounded-xl p-3 text-slate-900 text-sm font-semibold"
                  />
                  <datalist id="korlas-kelas-list">
                    {['1', '2', '3', '4', '5', '6'].flatMap((g) =>
                      ['A', 'B', 'C', 'D', 'E', 'F'].map((s) => `Kelas ${g}-${s}`)
                    ).map((cls) => (
                      <option key={cls} value={cls} />
                    ))}
                  </datalist>
                </div>
              )}

              {newUserRole === 'PARENT' && (
                <div className="p-3.5 bg-amber-50 border border-amber-200 rounded-xl space-y-2">
                  <label className="block text-amber-900 font-bold">👨‍👦 Pilih Nama Siswa (Anak dari Orang Tua Ini)</label>
                  <select required value={selectedChildStudentId} onChange={(e) => setSelectedChildStudentId(e.target.value)} className="w-full bg-white border border-amber-300 rounded-xl p-3 text-slate-900 text-sm">
                    <option value="">-- Pilih Siswa Terdaftar --</option>
                    {registeredStudents.map((st) => (
                      <option key={st.id} value={st.id}>{st.name} ({st.className || 'Kelas 5-A'})</option>
                    ))}
                  </select>
                </div>
              )}

              <div className="flex space-x-3 pt-2">
                <button type="button" onClick={() => setShowUserModal(false)} className="flex-1 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-semibold">Batal</button>
                <button type="submit" className="flex-1 py-2.5 rounded-xl bg-indigo-600 text-white font-semibold shadow-md">Simpan Account</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* Modal 8: Payment Settlement Modal */}
      {showPayModal && selectedBilling && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-xs p-4">
          <div className="bg-white w-full max-w-md p-6 rounded-2xl border border-slate-200 shadow-2xl space-y-4">
            <div className="flex justify-between items-center pb-3 border-b border-slate-100">
              <h3 className="text-base font-bold text-slate-900">Catat Pelunasan Pembayaran Siswa</h3>
              <button onClick={() => setShowPayModal(false)} className="text-slate-400 text-lg">✕</button>
            </div>

            <form onSubmit={handleSettlePayment} className="space-y-4 text-xs">
              <div className="p-3 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                <p className="text-slate-500">Siswa: <span className="font-bold text-slate-900">{selectedBilling.studentName}</span> ({selectedBilling.className || 'Kelas 5-A'})</p>
                <p className="text-slate-500">Tagihan: <span className="font-bold text-indigo-600">{formatIDR(selectedBilling.amountDue)}</span></p>
              </div>

              <div>
                <label className="block text-slate-700 font-semibold mb-1">Metode Pembayaran</label>
                <select value={payMethod} onChange={(e) => setPayMethod(e.target.value)} className="w-full bg-slate-50 border border-slate-300 rounded-xl p-3 text-slate-900 text-sm">
                  <option value="Tunai / Cash">Tunai / Cash (Langsung Korlas)</option>
                  <option value="Transfer Bank (BCA)">Transfer Bank (BCA)</option>
                  <option value="Transfer Bank (Mandiri)">Transfer Bank (Mandiri)</option>
                  <option value="QRIS / Digital">QRIS Digital</option>
                </select>
              </div>

              <div className="flex space-x-3 pt-2">
                <button type="button" onClick={() => setShowPayModal(false)} className="flex-1 py-2.5 rounded-xl bg-slate-100 text-slate-700 font-semibold">Batal</button>
                <button type="submit" className="flex-1 py-2.5 rounded-xl bg-emerald-600 text-white font-semibold shadow-md">Simpan Pelunasan</button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}
