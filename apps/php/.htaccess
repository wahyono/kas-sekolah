<IfModule mod_rewrite.c>
    RewriteEngine On
    # Redirect all requests to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Protect sensitive files (.env, composer.json, etc.)
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

